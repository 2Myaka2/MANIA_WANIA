# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
*.egg-info/
.eggs/
build/
dist/
site/
*.whl

# Test, lint, type-check, and coverage artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# MANIA local outputs and runtime artifacts
outputs/
mania_output/
cache/
temp/
logs/
*.log

# Local scientific data directories
local_md/
local_md_small/
local_md_protein/
data/*

# Tracked lightweight reference notebook context
!data/reference/
data/reference/*
!data/reference/notebooks_libraries_v1_2/
data/reference/notebooks_libraries_v1_2/*
!data/reference/notebooks_libraries_v1_2/MANIA_analysis_v1_2.ipynb
!data/reference/notebooks_libraries_v1_3/
data/reference/notebooks_libraries_v1_3/*
!data/reference/notebooks_libraries_v1_2/MANIA_analysis_v1_3.ipynb
!data/reference/notebooks_libraries_v1_2/MANIA_preprocessing_v1_2.ipynb

# Keep notebook runtime/cache artifacts out of git
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Molecular dynamics trajectory, topology, and large scientific files
*.xtc
*.trr
*.tpr
*.dcd
*.psf
*.edr
*.gro
*.pdb
*.xvg
*.cpt

# Large tabular/binary analysis outputs
*.parquet

# Small test fixtures may be allowed later by explicit exception.
# Example:
# !tests/fixtures/**/*.parquet
