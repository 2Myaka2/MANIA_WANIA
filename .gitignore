cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Project runtime outputs
outputs/
mania_output/
cache/
temp/
logs/

# Large scientific data
*.xtc
*.trr
*.tpr
*.gro
*.pdb
*.cpt
*.edr
*.xvg
*.parquet
EOF

data/
outputs/
mania_output/
*.xtc
*.tpr
*.dcd
*.psf
*.trr
*.edr
*.gro
*.pdb
*.parquet